{
    "name": "wapcaf/delta-sharing-php",
    "description": "PHP connector for the Delta Sharing open protocol",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/wapcaf/delta-sharing-php",
    "authors": [
        {
            "name": "Jake Macklin",
            "email": "jake.macklin@cruisenation.com"
        }
    ],
    "support": {
        "issues": "https://github.com/wapcaf/delta-sharing-php/issues",
        "source": "https://github.com/wapcaf/delta-sharing-php"
    },
    "keywords": [
        "delta-sharing",
        "delta-lake",
        "databricks",
        "data-sharing",
        "lakehouse",
        "parquet"
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "ext-bcmath": "*",
        "ext-json": "*",
        "ext-zlib": "*",
        "composer/ca-bundle": "^1.5",
        "flow-php/parquet": "~0.28.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "DeltaSharing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeltaSharing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
