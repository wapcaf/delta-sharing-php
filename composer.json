{
    "name": "wapcaf/delta-sharing-php",
    "description": "PHP connector for the Delta Sharing open protocol",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/wapcaf/delta-sharing-php",
    "authors": [
        {
            "name": "Jake Macklin",
            "email": "jake.macklin@cruisenation.com"
        }
    ],
    "support": {
        "issues": "https://github.com/wapcaf/delta-sharing-php/issues",
        "source": "https://github.com/wapcaf/delta-sharing-php"
    },
    "keywords": [
        "delta-sharing",
        "delta-lake",
        "databricks",
        "data-sharing",
        "lakehouse"
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "composer/ca-bundle": "^1.5",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "codename/parquet": "^0.7"
    },
    "suggest": {
        "codename/parquet": "Needed to decode parquet data files into PHP arrays (requires ext-gmp)"
    },
    "autoload": {
        "psr-4": {
            "DeltaSharing\\": "src/"
        },
        "files": [
            "src/snappy_polyfill.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DeltaSharing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
